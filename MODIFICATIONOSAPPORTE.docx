DROP TABLE IF EXISTS historique_stocks_recycleurs;
DROP TABLE IF EXISTS stocks_recycleurs;

CREATE TABLE stocks_recycleurs (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    recycleur_id UUID NOT NULL REFERENCES recycleurs(id),
    type_dechet type_dechet NOT NULL,
    quantite_disponible NUMERIC(10,2) DEFAULT 0 NOT NULL,
    unite VARCHAR(20) DEFAULT 'kg',
    dernier_mouvement TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    cree_le TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    modifie_le TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(recycleur_id, type_dechet)
);

CREATE TABLE historique_stocks_recycleurs (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    recycleur_id UUID NOT NULL REFERENCES recycleurs(id),
    type_mouvement VARCHAR(50) NOT NULL,
    type_dechet type_dechet NOT NULL,
    quantite NUMERIC(10,2) NOT NULL,
    stock_avant NUMERIC(10,2) NOT NULL,
    stock_apres NUMERIC(10,2) NOT NULL,
    reference_id UUID,
    reference_type VARCHAR(50),
    notes TEXT,
    cree_le TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Index
CREATE INDEX idx_stocks_recycleurs_recycleur ON stocks_recycleurs(recycleur_id);
CREATE INDEX idx_historique_stocks_recycleur ON historique_stocks_recycleurs(recycleur_id);