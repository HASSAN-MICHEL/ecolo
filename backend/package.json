{
  "name": "ecobackend",
  "version": "1.0.0",
  "description": "API Backend pour EcoCollect",
  "type": "module",
  "main": "api.js",
  "scripts": {
    "start": "node api.js",
    "dev": "nodemon api.js",
    "test": "jest --testPathPattern=test --passWithNoTests",
    "db:migrate": "node -e \"console.log('Migration script');\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleFileExtensions": ["js", "mjs"],
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "keywords": ["ecologie", "recyclage", "dechets"],
  "author": "HASSAN",
  "license": "MIT"
}